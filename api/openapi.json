{
  "openapi": "3.1.0",
  "info": {
    "title": "Flare",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/runs": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "List runs, newest first.",
        "operationId": "get_runs",
        "parameters": [
          {
            "name": "job_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/RunStatus"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Runs matching the filters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or bad auth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/v1/runs/{id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "Get a run with its steps.",
        "operationId": "get_run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Run found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or bad auth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      },
      "put": {
        "tags": [
          "runs"
        ],
        "summary": "Start a run with a client-chosen id. Repeating it for a running run of the same job succeeds.",
        "operationId": "put_run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartRun"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Run started"
          },
          "401": {
            "description": "Missing or bad auth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Run id belongs to another job or the run is no longer running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Referenced worker does not exist",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "job_token": []
          }
        ]
      }
    },
    "/v1/runs/{id}/events": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "List the event timeline of a run.",
        "operationId": "get_events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Events of the run",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Event"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or bad auth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such run",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "admin_token": []
          }
        ]
      }
    },
    "/v1/runs/{id}/finish": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Finish a run with its final status.",
        "operationId": "post_finish",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinishRun"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Run finished"
          },
          "401": {
            "description": "Missing or bad auth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No such run for this job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Run already finished; recorded as a late report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Final status can not be running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "job_token": []
          }
        ]
      }
    },
    "/v1/runs/{id}/heartbeat": {
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "Record a heartbeat for a running run.",
        "operationId": "post_heartbeat",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Run id",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Heartbeat recorded"
          },
          "401": {
            "description": "Missing or bad auth token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No running run with this id for this job",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlareErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "job_token": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Event": {
        "type": "object",
        "required": [
          "id",
          "run_id",
          "kind",
          "source",
          "payload",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "payload": {},
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "$ref": "#/components/schemas/EventSource"
          }
        }
      },
      "EventKind": {
        "type": "string",
        "enum": [
          "started",
          "step_started",
          "step_finished",
          "finished",
          "heartbeat_timeout",
          "late_report",
          "log"
        ]
      },
      "EventSource": {
        "type": "string",
        "enum": [
          "client",
          "server"
        ]
      },
      "FinishRun": {
        "type": "object",
        "required": [
          "final_status"
        ],
        "properties": {
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "final_status": {
            "$ref": "#/components/schemas/RunStatus"
          }
        }
      },
      "FlareErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Run": {
        "type": "object",
        "required": [
          "id",
          "job_id",
          "worker_id",
          "trigger",
          "status",
          "failure_reason",
          "started_at",
          "last_heartbeat_at",
          "finished_at",
          "exit_code"
        ],
        "properties": {
          "exit_code": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "failure_reason": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/RunFailure"
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "job_id": {
            "type": "string",
            "format": "uuid"
          },
          "last_heartbeat_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/RunStatus"
          },
          "trigger": {
            "$ref": "#/components/schemas/RunTrigger"
          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "RunDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Run"
          },
          {
            "type": "object",
            "required": [
              "steps"
            ],
            "properties": {
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Step"
                }
              }
            }
          }
        ]
      },
      "RunFailure": {
        "type": "string",
        "enum": [
          "reported",
          "heartbeat_timeout",
          "missed"
        ]
      },
      "RunStatus": {
        "type": "string",
        "enum": [
          "running",
          "succeeded",
          "failed",
          "aborted"
        ]
      },
      "RunTrigger": {
        "type": "string",
        "enum": [
          "external",
          "schedule",
          "ui",
          "missed"
        ]
      },
      "StartRun": {
        "type": "object",
        "properties": {
          "trigger": {
            "$ref": "#/components/schemas/RunTrigger"
          },
          "worker_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      },
      "Step": {
        "type": "object",
        "required": [
          "id",
          "run_id",
          "name",
          "position",
          "status",
          "started_at",
          "finished_at"
        ],
        "properties": {
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "position": {
            "type": "integer",
            "format": "int32"
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "$ref": "#/components/schemas/StepStatus"
          }
        }
      },
      "StepStatus": {
        "type": "string",
        "enum": [
          "running",
          "succeeded",
          "failed"
        ]
      }
    },
    "securitySchemes": {
      "admin_token": {
        "type": "http",
        "scheme": "bearer",
        "description": "Admin token for admin panel"
      },
      "job_token": {
        "type": "http",
        "scheme": "bearer",
        "description": "Job token for running specific job"
      }
    }
  }
}

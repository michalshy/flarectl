server {
    listen 80;
    root /usr/share/nginx/html;

    # API: forwarded to the Flare server, so the browser only talks to this origin (no CORS),
    # the same way the Vite proxy works in dev.
    location /v1/ {
        proxy_pass ${FLARE_API_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Built assets have a content hash in their file name, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Everything else is a client-side route (/runs, /runs/<id>, /jobs): serve the app and let
    # React Router pick the page. Without this, a refresh on /runs/<id> would be a 404.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
